{
  "run": {
    "name": "test_spectral",
    "output_dir": "runs",
    "seed": 7,
    "deterministic": true,
    "device": "cpu",
    "dtype": "float32"
  },
  "pde": {
    "name": "poisson_1d",
    "domain": [
      -1.0,
      1.0
    ],
    "source": 50.0,
    "boundary_values": [
      0.0,
      0.0
    ],
    "validation_points": 1001
  },
  "model": {
    "input_dim": 1,
    "output_dim": 1,
    "hidden_layers": [
      16,
      16,
      16,
      16,
      16
    ],
    "activation": "tanh"
  },
  "training": {
    "optimizer": "adam",
    "learning_rate": 0.001,
    "steps": 2000,
    "interior_points": 256,
    "boundary_points": 2,
    "log_every": 100,
    "checkpoint_every": 1000,
    "lambda_pde": 1.0,
    "lambda_bc": 1.0
  },
  "logging": {
    "save_activations": false,
    "activation_layers": [
      1
    ],
    "save_pointwise_residuals": true
  }
}
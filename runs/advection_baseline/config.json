{
  "run": {
    "name": "advection_baseline",
    "output_dir": "runs",
    "seed": 7,
    "deterministic": true,
    "device": "cuda",
    "dtype": "float32",
    "failure_label": "unlabeled"
  },
  "pde": {
    "name": "advection_1d",
    "domain": [
      0.0,
      1.0
    ],
    "source": 1.0,
    "forcing": 0.0,
    "diffusion": 0.01,
    "boundary_values": [
      1.0,
      0.0
    ],
    "validation_points": 1001
  },
  "model": {
    "input_dim": 1,
    "output_dim": 1,
    "hidden_layers": [
      64,
      64,
      64,
      64
    ],
    "activation": "tanh",
    "init": "xavier",
    "fourier_embed": false,
    "fourier_n_freq": 32,
    "fourier_scale": 1.0
  },
  "training": {
    "optimizer": "adam",
    "learning_rate": 0.001,
    "steps": 10000,
    "interior_points": 256,
    "boundary_points": 1,
    "log_every": 100,
    "checkpoint_every": 1000,
    "lambda_pde": 1.0,
    "lambda_bc": 1.0,
    "resample_every": 0,
    "spatial_bias": 0.0
  },
  "logging": {
    "save_activations": true,
    "activation_layers": [
      0,
      1,
      2
    ],
    "save_pointwise_residuals": true,
    "log_gradients": true,
    "grad_log_every": 100,
    "log_diagnostics": true,
    "diag_log_every": 100
  },
  "sae": null,
  "intervention": null,
  "monitor": null,
  "controller": null
}